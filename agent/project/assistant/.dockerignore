# ============================================================
#  docker build 时"不要打包进镜像"的东西
#  作用：减小构建上下文 + 防止把密钥/数据/缓存烤进镜像
# ============================================================

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- 运行时数据（运行时用 volume 挂进来，不烤进镜像）----
*.db
*.db-journal
my_notes/
test_memory.json

# ---- 开发期文件 ----
.tmp/
.claude/
tests/
eval/
*.log
*.bak
*.md

# ---- 密钥（绝对不能进镜像！）----
.env
*.env

# ---- 冗余的旧索引 ----
knowledge/embeddings_v1.json